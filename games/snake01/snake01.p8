pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- ヘのちハ…⬇️ヘい♥ヤもあハ…つハˇかハ⬅️ˇフˇつホえけヘ☉♥ハ⬅️ˇヒ✽⬅️フいなヒそ▥フ웃☉
s_food = 1
s_head_r, s_head_l, s_head_u, s_head_d = 2, 3, 4, 5
s_body_h, s_body_v = 6, 7
s_tail_r, s_tail_l, s_tail_u, s_tail_d = 8, 9, 10, 11
s_cor_ru, s_cor_lu, s_cor_ld, s_cor_rd = 12, 13, 14, 15

function _init()
 snake = {
  {x=7, y=7}, 
  {x=6, y=7},
  {x=5, y=7}
 }
 dir = {x=1, y=0}
 next_dir = {x=1, y=0}
 
 score = 0
 level = 1
 target_score = 150 
 
 game_started = false -- ヒ∧ぬハけおヤもあヒ▤にハ…すハほのホ∧⬅️ハせ⬅️ホ▒⌂フ🅾️た
 game_over = false
 win_pause = 0      
 timer = 0
 speed = 8 
 
 spawn_food()
end

function spawn_food()
 food = {x=flr(rnd(16)), y=flr(rnd(16))}
 for s in all(snake) do
  if (food.x == s.x and food.y == s.y) spawn_food()
 end
end

function _update()
 -- 1. ハす🐱ヒおうホ🐱░ヒの★ホ∧⬅️ハせ⬅️ヤも😐フと웃ハゆ✽フ🅾️たハなへヒ😐웃ホ♪ふ
 if not game_started then
  if btn(4) or btn(5) then
   game_started = true
   sfx(1) -- ヒ★とヒ⬆️ゆホ∧⬅️ハせ⬅️ホかはヒˇ☉
  end
  return
 end

 -- 2. ホ▒⌂ヒ☉のフふ…ヒえかホ♥♪ハˇか
 if game_over then
  if (btn(4) or btn(5)) run()
  return
 end

 -- 3. ホ▒🅾️ホ❎うフかとヒあつハ▒うホき⧗
 if win_pause > 0 then
  win_pause -= 1
  return
 end

 -- 4. ヒ∧みハ…➡️ヘもまハ✽し
 if btn(0) and dir.x == 0 then next_dir = {x=-1, y=0} end
 if btn(1) and dir.x == 0 then next_dir = {x=1, y=0} end
 if btn(2) and dir.y == 0 then next_dir = {x=0, y=-1} end
 if btn(3) and dir.y == 0 then next_dir = {x=0, y=1} end

 -- 5. フせめハ⬅️ˇホ🐱◆ヘもに
 timer += 1
 if timer >= speed then
  timer = 0
  dir = next_dir
  sfx(3) -- フせめハ⬅️ˇヘ▒の
  
  local head = snake[1]
  local new_head = {x = head.x + dir.x, y = head.y + dir.y}
  
  if new_head.x < 0 or new_head.x > 15 or new_head.y < 0 or new_head.y > 15 then
   kill_snake()
   return
  end
  for s in all(snake) do
   if (new_head.x == s.x and new_head.y == s.y) then
    kill_snake()
    return
   end
  end

  add(snake, new_head, 1)
  
  -- 6. ハ…⬇️ホこかフ웃たヘ☉♥フいなヒそ▥ホ▒⬆️ヒ☉…
  if new_head.x == food.x and new_head.y == food.y then
   score += 10
   sfx(1) 
   
   if score >= target_score then
    level += 1
    target_score += 50 
    win_pause = 30     
   end
   
   if score < 300 then
    speed = max(2, speed - 0.2)
   else
    speed = 2 
   end
   spawn_food()
  else
   del(snake, snake[#snake])
  end
 end
end

function kill_snake()
 game_over = true
 sfx(0)
end

function _draw()
 cls(0)
 rect(0,0,127,127,5) 
 
 -- フみちヘこやホこかフ웃た
 spr(s_food, food.x*8, food.y*8)
 
 -- フみちヘこやヘい♥
 for i=1,#snake do
  local s = snake[i]
  local sp = s_body_h
  if i == 1 then
   local n = snake[i+1]
   if n then
    if (s.x > n.x) sp=s_head_r
    if (s.x < n.x) sp=s_head_l
    if (s.y < n.y) sp=s_head_u
    if (s.y > n.y) sp=s_head_d
   end
  elseif i == #snake then
   local p = snake[i-1]
   if (s.x < p.x) sp=s_tail_r
   if (s.x > p.x) sp=s_tail_l
   if (s.y > p.y) sp=s_tail_u
   if (s.y < p.y) sp=s_tail_d
  else
   local p = snake[i-1]
   local n = snake[i+1]
   if p.x == n.x then sp = s_body_v
   elseif p.y == n.y then sp = s_body_h
   else
    local dx = (p.x - s.x) + (n.x - s.x)
    local dy = (p.y - s.y) + (n.y - s.y)
    if (dx==1 and dy==-1) sp=s_cor_ru
    if (dx==-1 and dy==-1) sp=s_cor_lu
    if (dx==-1 and dy==1)  sp=s_cor_ld
    if (dx==1 and dy==1)   sp=s_cor_rd
   end
  end
  spr(sp, s.x*8, s.y*8)
 end
 
 -- ホき🐱ホ⬇️そヘは♥ヘそ⌂ヒて░
 print("lvl:"..level, 4, 4, 7)
 print("score:"..score, 35, 4, 7)
 print("goal:"..target_score, 80, 4, 11)
 
 -- === ノま♪ハ…😐フあ░フ⬅️█ヒ✽⬅️ホくにフさむノま♪ハ…😐フあ░ノめ⬅️ホえけ ===
 
 -- 1. ハˇかハ⬅️ˇフˇつホえけ (ホ▒⌂ヒ☉のハぬあヒうちホ∧⬅️ハせ⬅️)
 if not game_started then
  rectfill(15,40,113,85,0) -- ホめ➡️ヘ웃のヘ⬇️😐ヒ▥にヒく●
  rect(15,40,113,85,7)     -- フ▥やヘ웃のホ🐱⌂ヒく●
  print("snake game", 44, 48, 14)
  print("initial goal: 150", 32, 60, 6)
  print("press z/x to start", 30, 72, 7)
 end

 -- 2. ホ▒🅾️ホ❎うヒ◆…フさむ
 if win_pause > 0 then
  rectfill(10,55,118,75,11)
  rectfill(12,57,116,73,0)
  print("level up! goal now: "..target_score, 20, 62, 7)
 end

 -- 3. ホ▒⌂ヒ☉のフふ…ヒえか
 if game_over then
  rectfill(20,50,108,80,0)
  print("game over", 46, 58, 8)
  print("press z/x to restart", 28, 68, 6)
 end
end
